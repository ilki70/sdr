ATENDENTE3_HOST=pulse.orfi.com.br
ATENDENTE3_DBADMIN_HOST=pulse-db.orfi.com.br
ATENDENTE3_DBADMIN_ALLOWLIST=201.75.189.147/32

TRAEFIK_NETWORK=orfinet3
TRAEFIK_CERTRESOLVER=letsencryptresolver

POSTGRES_DB=atendente3
POSTGRES_USER=atendente3
POSTGRES_PASSWORD=atendente3
DATABASE_URL=postgresql+asyncpg://atendente3:atendente3@postgres:5432/atendente3

ALLOWED_ORIGINS=*
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

NEXT_PUBLIC_APP_URL=https://pulse.orfi.com.br
BACKEND_INTERNAL_URL=http://backend:8000
SESSION_SECRET=replace-with-32-plus-chars

BACKEND_IMAGE=ghcr.io/ilki70/sdr/backend:latest
FRONTEND_IMAGE=ghcr.io/ilki70/sdr/frontend:latest
WHATSAPP_SERVICE_IMAGE=ghcr.io/ilki70/sdr/whatsapp-service:latest
BACKEND_WEBHOOK_URL=http://backend:8000/api/v1/whatsapp/webhook
WHATSAPP_DEFAULT_INBOX_REF=whatsapp-default
WHATSAPP_WEBHOOK_SECRET=replace-with-integration-secret
